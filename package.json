{
  "name": "study-notes-claude",
  "version": "0.1.0",
  "description": "Study short-notes app with an embedded Claude CLI terminal and real-time file sync",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "rebuild": "electron-rebuild -f -w node-pty",
    "dist": "electron-builder --mac dir",
    "dmg": "electron-builder --mac dmg",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "vitest run && playwright test"
  },
  "author": "",
  "license": "MIT",
  "build": {
    "appId": "com.pasawit.studynotes",
    "productName": "Washi",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "node_modules/**/*",
      "notes/*.md",
      "!notes/.trash/**",
      "!notes/.srs.json"
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ],
    "mac": {
      "target": "dir",
      "category": "public.app-category.education",
      "icon": "build/icon.icns",
      "identity": null
    },
    "directories": {
      "output": "dist"
    }
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@playwright/test": "^1.48.0",
    "electron": "^33.2.0",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.28.1",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "@milkdown/crepe": "^7.21.3",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "chokidar": "^3.6.0",
    "codemirror": "^5.65.21",
    "hypermd": "^0.3.11",
    "marked": "^12.0.2",
    "node-pty": "^1.0.0",
    "pdfjs-dist": "^3.11.174"
  }
}
