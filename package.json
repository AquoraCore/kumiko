{
  "name": "study-notes-claude",
  "version": "0.2.0",
  "description": "Study short-notes app with an embedded Claude CLI terminal and real-time file sync",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac dir",
    "dmg": "electron-builder --mac dmg",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "vitest run && playwright test",
    "predeploy": "vitest run",
    "deploy": "bash scripts/deploy-ally.sh",
    "relay": "node server/relay.js",
    "server": "node server/index.js",
    "build:crepe": "esbuild build/crepe-entry.js --bundle --format=iife --loader:.ttf=dataurl --loader:.woff=dataurl --loader:.woff2=dataurl --loader:.eot=dataurl --loader:.svg=dataurl --outfile=renderer/vendor/crepe.bundle.js",
    "build:mermaid": "esbuild build/mermaid-entry.js --bundle --format=iife --outfile=renderer/vendor/mermaid.bundle.js",
    "build:ocr": "swiftc -O native/pdf-ocr.swift -o native/pdf-ocr"
  },
  "author": "",
  "license": "MIT",
  "build": {
    "appId": "com.pasawit.studynotes",
    "productName": "Kumiko",
    "files": [
      "main.js",
      "preload.js",
      "core/**/*",
      "renderer/**/*",
      "node_modules/**/*",
      "notes/*.md",
      "!notes/.trash/**",
      "!notes/.srs.json"
    ],
    "mac": {
      "target": "dir",
      "category": "public.app-category.education",
      "icon": "build/icon.icns",
      "identity": null
    },
    "extraResources": [
      { "from": "native/pdf-ocr", "to": "pdf-ocr" }
    ],
    "directories": {
      "output": "dist"
    }
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@playwright/test": "^1.48.0",
    "electron": "^33.2.0",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.28.1",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "@milkdown/crepe": "^7.21.3",
    "@milkdown/plugin-collab": "^7.21.3",
    "@y/websocket-server": "^0.1.5",
    "bcryptjs": "^3.0.3",
    "chokidar": "^3.6.0",
    "codemirror": "^5.65.21",
    "express": "^5.2.1",
    "google-auth-library": "^11.0.0",
    "hypermd": "^0.3.11",
    "jsonwebtoken": "^9.0.3",
    "marked": "^12.0.2",
    "pdfjs-dist": "^3.11.174",
    "ws": "^8.21.1",
    "y-prosemirror": "^1.3.7",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.31"
  }
}
